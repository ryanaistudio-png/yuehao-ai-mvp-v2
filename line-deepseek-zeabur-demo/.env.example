PORT=3000

# LINE Developers -> Messaging API
LINE_CHANNEL_ACCESS_TOKEN=貼上你的_LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=貼上你的_LINE_CHANNEL_SECRET

# DeepSeek API
DEEPSEEK_API_KEY=貼上你的_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Apps Script Web App
APPS_SCRIPT_WEB_APP_URL=貼上你的_Apps_Script_Web_App_URL
APPS_SCRIPT_API_TOKEN=貼上90系統設定裡的_api_token

# 店家通知：可以先留空，Demo 成功後再填店家 LINE userId 或 groupId
SHOP_NOTIFY_LINE_ID=

# Demo 設定
SESSION_TTL_MINUTES=10
DEFAULT_TIMEZONE=Asia/Taipei
